{
  "name": "pharmatrack",
  "private": true,
  "version": "1.1.88",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:development": "tsc && vite build --mode development",
    "build:staging": "tsc && vite build --mode staging",
    "build:production": "tsc && vite build --mode production",
    "ci:gate": "node scripts/ci-gate.mjs",
    "cf:dev": "npm run build && wrangler dev --local --config wrangler.toml",
    "cf:deploy:staging": "VITE_CLOUDFLARE_API_BASE_URL=https://pharmatrack-api-staging.g2code331.workers.dev npm run build && wrangler deploy --env staging --config wrangler.toml && wrangler pages deploy dist --project-name pharmatrack-web-staging --branch main",
    "cf:deploy:production": "VITE_CLOUDFLARE_API_BASE_URL=https://pharmatrack-api-production.g2code331.workers.dev npm run build && wrangler deploy --env production --config wrangler.toml && wrangler pages deploy dist --project-name pharmatrack-web --branch main",
    "cf:smoke": "node scripts/cloudflare-smoke.mjs",
    "cf:typecheck": "tsc -p cloudflare/worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs check",
    "tauri": "tauri",
    "tauri:dev": "env -u LD_LIBRARY_PATH WEBKIT_DISABLE_COMPOSITING_MODE=1 GDK_BACKEND=x11 tauri dev",
    "tauri:build": "env -u LD_LIBRARY_PATH tauri build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.140.0"
  }
}
