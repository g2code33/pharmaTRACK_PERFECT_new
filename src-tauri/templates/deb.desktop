[Desktop Entry]
Categories={{{categories}}}
{{#if comment}}
Comment={{{comment}}}
{{/if}}
Exec=/usr/bin/env WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{{exec}}} %U
Icon={{{icon}}}
Name={{{name}}}
Terminal=false
Type=Application
MimeType=application/x-pharmaexam;x-scheme-handler/pharmatrack;
StartupNotify=true
