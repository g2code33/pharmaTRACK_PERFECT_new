# PharmaTRACK Environment Configuration Template
# Copy to .env.development, .env.staging, or .env.production as needed.
# NEVER commit secret service_role keys or private keys to client env files.
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-publishable-anon-key>
VITE_CLOUDFLARE_API_BASE_URL=https://<your-worker-api>.<your-subdomain>.workers.dev
