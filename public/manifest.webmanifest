{
  "id": "./index.html#/",
  "name": "PharmaTRACK",
  "short_name": "PharmaTRACK",
  "description": "Offline-first pharmacy study, examination, and academic workspace.",
  "start_url": "./index.html#/",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+pharmatrack",
      "url": "./index.html#/app-link?url=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pharmatrack-web.pages.dev/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false,
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.ico",
      "sizes": "16x16 24x24 32x32 48x48",
      "type": "image/x-icon",
      "purpose": "any"
    }
  ]
}
